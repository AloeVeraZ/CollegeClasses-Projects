rotaxerror   : 0     #Error flag
rot_axis     : 0     #Axis of rotation - 1=X, 2=Y, 3=Z
rot_dir      : 0     #Rotary direction - CW is positive, 0 = false, 1 = true
rot_index    : 0     #Index or continuous - 0 = continuous, 1 = index
